# ---------------------------------------------------------------------------
# Live Translation — environment template
# Copy to `.env` and fill in.  `.env` is gitignored; NEVER commit real keys.
#   PowerShell:  Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# Gemini API key from https://aistudio.google.com/apikey
# SERVER-SIDE ONLY. This is never sent to the browser — the server exchanges it
# for short-lived ephemeral tokens (see server/index.ts).
# It has no VITE_ prefix on purpose: Vite only exposes VITE_* to client code,
# so this key cannot leak into the bundle.
GEMINI_API_KEY=

# Port for the token server.
PORT=8787

# Origin(s) allowed to request ephemeral tokens, comma-separated.
# Dev default covers the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Ephemeral token lifetimes (minutes) -----------------------------------
# expireTime: how long the token remains usable overall.
# newSessionExpireTime: window in which the token may START a new session.
TOKEN_EXPIRE_MINUTES=30
TOKEN_NEW_SESSION_EXPIRE_MINUTES=2
